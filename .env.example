# Copy to .env for local development. In production, set these as environment
# variables in your hosting dashboard instead of using a file.

# --- Environment ---
# dev        loads .env (this file)
# test       loads .env.test (set automatically by `pnpm test`)
# production loads no file; everything comes from real environment variables
# If unset it is derived from NODE_ENV (NODE_ENV=production -> production)
APP_STAGE=dev
NODE_ENV=development

# --- Server ---
PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://username:password@localhost:5432/habit_tracker_db

# --- Auth ---
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
# bcrypt cost, 10-20. Higher = slower and safer
BCRYPT_ROUNDS=12

# --- CORS ---
# Comma separated browser origins that may call the API.
# Production: required for browser apps, e.g. https://my-frontend.example.com
# Dev/test: leave empty to allow any origin.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting (per client IP) ---
# /api allows RATE_LIMIT_MAX_REQUESTS per window; /api/auth is capped at 20.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
